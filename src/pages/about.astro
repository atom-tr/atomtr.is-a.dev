---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE } from "@/consts"
---

<Layout crumbs={[{ label: "About", href: "/about" }]}>
  <MetaPage
    slot="head"
    title="About"
    description="About Thai Tran (atomtr) - DevOps Engineer & Developer"
  />

  <article class="about-container">
    <header>
      <h1>About Me</h1>
      <p class="subtitle">Thai Tran &bull; DevOps Engineer &amp; Developer</p>
    </header>

    <prose-content>
      <section>
        <h2>Bio</h2>
        <p>
          I am a DevOps Engineer and Developer with 5+ years of experience in
          system administration, infrastructure automation, and software
          engineering. I specialize in cloud-native platforms, Kubernetes, CI/CD
          pipelines, and Python/Bash scripting.
        </p>
      </section>

      <section>
        <h2>Experience &amp; Roles</h2>

        <h3>DevOps Engineer</h3>
        <p>
          Automating the software delivery lifecycle from building code (CI) to
          multi-environment deployment (CD). Managing Kubernetes workloads,
          containerization, observability (Prometheus/Grafana/Loki), and
          Infrastructure as Code (IaC) with Terraform, Terragrunt, and ArgoCD.
        </p>

        <h3>Software Developer &amp; System Administrator</h3>
        <p>
          Over 4 years of hands-on experience in backend development and systems
          engineering. Focused on Python (Django/FastAPI/Celery), MySQL/Redis
          databases, network management web tools, and Linux system internals.
        </p>
      </section>

      <section>
        <h2>Technical Skills</h2>
        <ul>
          <li>
            <strong>Languages:</strong>
            Python, Bash / Shell Scripting, SQL
          </li>
          <li>
            <strong>DevOps &amp; Cloud:</strong>
            Docker, Kubernetes, Linux, CI/CD, GitOps, Terraform
          </li>
          <li>
            <strong>Observability &amp; Networking:</strong>
            Prometheus, Grafana, Loki, Nginx, Cloudflare
          </li>
          <li>
            <strong>Backend Frameworks:</strong>
            Django, Django REST Framework, FastAPI, Celery, Redis
          </li>
        </ul>
      </section>

      <section>
        <h2>Connect</h2>
        <p>
          Feel free to reach out via
          <a href="mailto:thai.tr@hotmail.com">Email</a>
          or check out my work on
          <a
            href="https://github.com/atom-tr"
            target="_blank"
            rel="noopener noreferrer"
            >GitHub</a
          >.
        </p>
      </section>
    </prose-content>
  </article>
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      margin-block-end: var(--space-3xs);
    }

    .subtitle {
      color: var(--muted-foreground);
      font-size: var(--step-0);
    }
  }

  prose-content {
    display: block;

    section {
      margin-block-end: var(--space-l);

      h2 {
        font-size: var(--step-1);
        margin-block-end: var(--space-xs);
        border-bottom: 1px solid var(--border);
        padding-bottom: var(--space-3xs);
      }

      h3 {
        font-size: var(--step-0);
        margin-block-start: var(--space-s);
        margin-block-end: var(--space-3xs);
      }

      ul {
        margin-block-start: var(--space-2xs);
        padding-inline-start: var(--space-m);

        li {
          margin-block-end: var(--space-3xs);
        }
      }
    }
  }
</style>

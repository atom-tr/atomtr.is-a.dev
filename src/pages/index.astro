---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"
import { SITE } from "@/consts"

const recentPosts = (await getPosts()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" />

  <section class="hero-section">
    <h1>Thai Tran <span class="handle">(@atomtr)</span></h1>
    <p class="role">DevOps Engineer &amp; Systems Developer</p>
    <p class="bio">
      Welcome to my personal archive. This site is a minimalist repository of my
      engineering notes, architecture decisions, infrastructure experiments, and
      software projects.
    </p>

    <div class="quick-links">
      <a href="/archive" class="cta-link">&rarr; Explore Archive</a>
      <a href="/projects" class="cta-link">&rarr; View Projects</a>
      <a href="/about" class="cta-link">&rarr; About Me</a>
    </div>
  </section>

  <hr>

  <section class="recent-section">
    <h2>Recent Archive Entries</h2>
    {recentPosts.length > 0 ? (
      <ul>
        {recentPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </ul>
    ) : (
      <p class="empty-note">No entries recorded yet.</p>
    )}
  </section>
</Layout>

<style>
  .hero-section {
    display: block;
    margin-block-end: var(--space-l);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-3xs);

      .handle {
        font-size: var(--step-0);
        color: var(--muted-foreground);
        font-weight: normal;
      }
    }

    .role {
      font-size: var(--step-0);
      color: var(--muted-foreground);
      margin-block-end: var(--space-s);
    }

    .bio {
      font-size: var(--step-0);
      line-height: 1.6;
      color: var(--foreground);
      max-inline-size: 55ch;
      margin-block-end: var(--space-m);
    }

    .quick-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-m);

      .cta-link {
        font-weight: var(--font-weight-medium);
        color: var(--foreground);
        text-decoration-line: underline;
        text-underline-offset: 3px;

        &:hover {
          color: var(--muted-foreground);
        }
      }
    }
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin-block: var(--space-l);
  }

  .recent-section {
    h2 {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-m);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
      list-style: none;
      padding: 0;
    }

    .empty-note {
      color: var(--muted-foreground);
      font-style: italic;
    }
  }
</style>
